# Sanity - get these from https://www.sanity.io/manage (or run `npx sanity init`)
NEXT_PUBLIC_SANITY_PROJECT_ID="your-project-id"
NEXT_PUBLIC_SANITY_DATASET="production"
# Optional: pin the API version (defaults to 2024-10-01)
NEXT_PUBLIC_SANITY_API_VERSION="2024-10-01"

# Write token - only needed to run `pnpm seed`. Create one at
# sanity.io/manage -> your project -> API -> Tokens (Editor role). Never commit it.
SANITY_API_TOKEN=""

# Optional server-side READ token used by the site to fetch posts. Required only
# if your dataset is private; for a public dataset it's optional (the app falls
# back to SANITY_API_TOKEN locally). Use a "Viewer" role token in production.
SANITY_API_READ_TOKEN=""

# Production domain - used to build every absolute URL on the site: the sitemap,
# canonical tags, Open Graph tags, JSON-LD, the RSS feed and llms.txt.
# Use the apex form with no trailing slash and no "www." - www is redirected to
# apex in next.config.ts, and a mismatch here would emit canonicals pointing at
# a URL that immediately redirects.
NEXT_PUBLIC_SITE_URL="https://chetanmangalwedhe.com"
